# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EXTRACT_MODEL=

# Supabase (Project Settings -> API Keys; URL is under Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Adzuna (optional - leave blank to disable this source)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Vercel Cron: protects /api/cron/warm (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=
