{
  "name": "offer-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:rls": "node --env-file=.env.local scripts/check-rls.ts",
    "check:live": "node --env-file=.env.local scripts/smoke-live.ts",
    "check:search": "tsx --conditions=react-server --env-file=.env.local scripts/check-search.mts",
    "boards:verify": "tsx --conditions=react-server scripts/verify-boards.mts",
    "snapshot": "tsx --conditions=react-server --env-file=.env.local scripts/snapshot-postings.mts",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval-extraction.mts",
    "check:triage": "tsx --conditions=react-server --env-file=.env.local scripts/check-triage.mts",
    "check:agent": "tsx --env-file=.env.local scripts/check-agent.mts",
    "eval:agent": "tsx --conditions=react-server --env-file=.env.local scripts/eval-agent.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "openai": "^7.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
